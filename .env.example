# Razorpay — copy to .env and fill in TEST-mode keys (no KYC needed)
# Get keys at https://dashboard.razorpay.com → toggle Test Mode → Settings → API Keys
# Keys starting with rzp_test_ never touch real money.
# Uncomment and replace BOTH values with your own test keys. Left commented (or
# still the xxxx placeholders), Razorpay calls run in SIMULATE mode automatically
# (see razorpay_client.keys_configured()), so `cp .env.example .env` gives a
# runnable pipeline before you've created a Razorpay account.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Route split demo only (python -m failsafe.route_demo --live): a real
# onboarded Linked Account id. Unset -> the labeled fake acc_sim_partner001.
# RAZORPAY_PARTNER_LINKED_ACCOUNT_ID=acc_xxxxxxxxxxxxxx

# Ollama — local LLM for diagnosis + proposal (https://ollama.com)
# Default host; override if Ollama runs elsewhere or on a different port.
OLLAMA_HOST=http://localhost:11434
# Model pulled during setup: `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b

# FailSafe console (python -m failsafe.console) - all optional
# FAILSAFE_AUDIT_LOG=logs/audit_log.jsonl
# FAILSAFE_POLICY=config/decline_policy.json
# FAILSAFE_DATA=data/halted_subscriptions.json
# FAILSAFE_OUT_DIR=/tmp/failsafe-pages
# HOST=127.0.0.1
# PORT=8080

# Agent / pipelines - all optional
# Consecutive invalid (non-enum) LLM actions that trip the fallback circuit
# breaker; missing, non-integer or < 1 falls back to the default 5.
# FAILSAFE_INVALID_ACTION_THRESHOLD=5
# Where RESULTS*.md / REPORT.html / POLICY_DASHBOARD.html are written
# (default: the project root; the Docker image uses /app/logs/results).
# FAILSAFE_RESULTS_DIR=logs/results
# Root holding config/, data/, logs/ (default: this checkout). Set it when
# running from a wheel install, which ships no data next to the package.
# FAILSAFE_HOME=/srv/failsafe
