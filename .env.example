# Copy this file to .env and fill in your own Razorpay TEST-MODE keys.
# Get them free, no KYC, at https://dashboard.razorpay.com (toggle to Test Mode).
# Keys starting rzp_test_ never touch real money.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# If these are left unset, razorpay_client.py runs in SIMULATE mode automatically
# so the whole pipeline is runnable before you've created a Razorpay account.

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
